{
    "name": "tacticmedia/scim-server-bundle",
    "description": "Symfony bundle for the tacticmedia/scim-server SCIM 2.0 server library.",
    "license": "MIT",
    "type": "symfony-bundle",
    "keywords": [
        "provisioning",
        "scim",
        "symfony",
        "symfony-bundle"
    ],
    "require": {
        "php": ">=8.5",
        "psr/clock": "^1.0",
        "symfony/config": "^8.1.11",
        "symfony/console": "^8.1",
        "symfony/dependency-injection": "^8.1",
        "symfony/http-foundation": "^8.1.11",
        "symfony/http-kernel": "^8.1.11",
        "symfony/password-hasher": "^8.1",
        "symfony/property-access": "^8.1",
        "symfony/property-info": "^8.1",
        "symfony/rate-limiter": "^8.1",
        "symfony/routing": "^8.1.11",
        "symfony/security-core": "^8.1",
        "symfony/security-http": "^8.1.11",
        "symfony/uid": "^8.1",
        "tacticmedia/scim-server": "^0.1"
    },
    "conflict": {
        "doctrine/doctrine-bundle": "<3.3",
        "doctrine/orm": "<3.7"
    },
    "suggest": {
        "doctrine/doctrine-bundle": "To store resources with Doctrine ORM.",
        "doctrine/orm": "To store resources with Doctrine ORM.",
        "symfony/validator": "To validate objects before a write, with #[ScimResource(validationGroups: [...])]."
    },
    "autoload": {
        "psr-4": {
            "TacticMedia\\ScimServerBundle\\": "src/"
        }
    },
    "extra": {
        "ai-mate": {
            "instructions": "INSTRUCTIONS.md",
            "skills": [
                "skills"
            ]
        }
    }
}
